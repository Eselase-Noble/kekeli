# ---- Server ----
PORT=3000

# Shared secret every device must send (header: x-api-key). Change this!
API_KEY=change-me-to-a-long-random-string

# ---- Database (Postgres) ----
# Local default matches a stock Homebrew Postgres. On cloud hosts (Render,
# Railway, Fly, Supabase) paste the connection string they give you here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecg_monitor

# ---- Outage detection ----
# A device is considered OFFLINE (= power out) if we haven't heard from it
# within this many seconds. Set it to a few missed heartbeats.
# e.g. device pings every 60s -> 180 gives 3 missed pings of grace.
OFFLINE_AFTER_SECONDS=180

# How often the monitor loop checks device states (seconds).
CHECK_INTERVAL_SECONDS=30

# ---- Prepaid balance ----
# Alert when units drop to/below this; gauge "full" reference; optional price
# per kWh (GHS) to estimate refill cost (0 hides cost). Currency label.
LOW_BALANCE_UNITS=10
FULL_BALANCE_UNITS=100
PRICE_PER_UNIT=0
CURRENCY=GHS

# ---- Email alerts (optional; free with Gmail app password) ----
# Leave blank to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
ALERT_EMAIL_TO=youraddress@gmail.com

# ---- Telegram alerts (optional; 100% free) ----
# Create a bot with @BotFather to get the token, then message your bot once
# and get your chat id from @userinfobot. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- SMS alerts via Arkesel (optional; Ghana) ----
# Get an API key + registered sender id from https://arkesel.com
# ALERT_SMS_TO = comma-separated phone numbers, e.g. 0244123456,0201234567
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ALERT_SMS_TO=
